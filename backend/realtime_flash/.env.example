# Realtime Flash 模块环境变量示例
# 复制为 backend/realtime_flash/.env 后按需调整

# ---------------------------
# 模块总开关
# ---------------------------
REALTIME_FLASH_ENABLED=true

# 日志级别: DEBUG / INFO / WARNING / ERROR
REALTIME_FLASH_LOG_LEVEL=INFO

# ---------------------------
# 去重缓存（本地文件，不涉及数据库结构变更）
# ---------------------------
REALTIME_FLASH_DEDUP_TTL_SECONDS=86400
REALTIME_FLASH_DEDUP_CACHE_FILE=data/realtime_flash/dedup_cache.json
REALTIME_FLASH_DEDUP_MAX_SIZE=20000

# 每轮抓取写入上限
REALTIME_FLASH_WRITER_BATCH_SIZE=100

# ---------------------------
# JIN10 WebSocket
# ---------------------------
REALTIME_FLASH_JIN10_WS_ENABLED=true
REALTIME_FLASH_JIN10_WS_URL=wss://flash.jin10.com/ws
REALTIME_FLASH_JIN10_WS_TIMEOUT_SECONDS=15
REALTIME_FLASH_JIN10_WS_RECONNECT_SECONDS=5
REALTIME_FLASH_JIN10_WS_SUBSCRIPTION_PAYLOAD={"action":"subscribe","channel":"flash"}

# ---------------------------
# FX678 轮询抓取
# ---------------------------
REALTIME_FLASH_FX678_ENABLED=true
REALTIME_FLASH_FX678_URL=https://data.fx678.com/flash/
REALTIME_FLASH_FX678_POLL_SECONDS=30
REALTIME_FLASH_FX678_TIMEOUT_SECONDS=12
REALTIME_FLASH_FX678_MAX_RETRIES=2

# HTTP 标识
REALTIME_FLASH_HTTP_USER_AGENT=InvestMindPro-RealtimeFlash/1.0 (+https://github.com/icysaintdx/InvestMind-Pro)

# ---------------------------
# 合规提示（仅注释，不参与运行）
# ---------------------------
# 1) 仅访问公开可访问入口，遵守目标站点 robots、ToS 和访问频率约束。
# 2) 若站点声明禁止嵌入/抓取，应立即停用对应源（*_ENABLED=false）。
# 3) 本模块默认作为内部研究用途，不构成外部分发或再售数据。
